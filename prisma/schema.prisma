generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String    @default("")
  name               String
  role               String    @default("comercial")
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdById        String?
  createdByUser      User?     @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  budgetsCreated     Budget[]  @relation("BudgetCreator")
  historyEntries     BudgetHistory[]
  createdUsers       User[]    @relation("UserCreator")
  permissions        String?
}

model Client {
  id            String   @id @default(cuid())
  businessName  String
  cif           String
  fiscalAddress String
  contactPerson String?
  email         String?
  phone         String?
  sector        String?
  paymentTerms  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  budgets       Budget[]
}

model Budget {
  id              String   @id @default(cuid())
  code            String   @unique
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  createdById     String
  createdBy       User     @relation("BudgetCreator", fields: [createdById], references: [id])
  status          String   @default("borrador")
  validUntil      String?
  description     String?
  subtotal        Float    @default(0)
  totalSurcharges Float    @default(0)
  discountPercent Float    @default(0)
  discountAmount  Float    @default(0)
  ivaPercent      Float    @default(21)
  ivaAmount       Float    @default(0)
  totalFinal      Float    @default(0)
  clientNotes     String?
  internalNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serviceBlocks   ServiceBlock[]
  history         BudgetHistory[]
}

model ServiceBlock {
  id                     String   @id @default(cuid())
  budgetId               String
  budget                 Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  serviceName            String
  professionalCategory   String
  professionalsRequested Int      @default(1)
  pricePerHour           Float
  internalCostPerHour    Float?
  internalMargin         Float?
  blockType              String?
  dateUIMode             String?
  dateMode               String   @default("range")
  specificDates          String?
  dateRangeStart         String?
  dateRangeEnd           String?
  daysOfWeek             String?
  excludeSundays         Boolean  @default(false)
  excludeHolidays        Boolean  @default(false)
  holidayTypesExcluded   String?
  shiftType              String   @default("morning")
  shiftStartTime         String?
  shiftEndTime           String?
  hoursPerDay            Float    @default(8)
  breakMinutes           Int      @default(0)
  unitType               String   @default("hora")
  quantity               Float    @default(1)
  fixedPrice             Float?
  courseName             String?
  courseTeacher          String?
  courseModality         String?
  courseSessions         Float?
  materialName           String?
  accommodationNights    Float?
  accommodationPersons   Float?
  transportType          String?
  totalWorkingDays       Int      @default(0)
  totalHours             Float    @default(0)
  totalSurcharges        Float    @default(0)
  minProfessionals       Int      @default(1)
  selectedProfessionals  Int      @default(1)
  overtimeHours          Float    @default(0)
  blockSubtotal          Float    @default(0)
  enabledSurcharges      String?
  surchargeBreakdown     String?
  laborWarnings          String?
  observations           String?
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model BudgetHistory {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  oldStatus String?
  newStatus String?
  snapshot  String?
  notes     String?
  createdAt DateTime @default(now())
}

model ProfessionalCategory {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  defaultPricePerHour Float
  defaultInternalCost Float?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SurchargeConfig {
  id            String   @id @default(cuid())
  name          String   @unique
  type          String
  surchargeType String   @default("percentage")
  value         Float
  description   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Holiday {
  id                  String   @id @default(cuid())
  date                String
  name                String
  type                String   @default("nacional")
  autonomousCommunity String?
  province            String?
  municipality        String?
  year                Int?
  recurring           Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model LaborRule {
  id                    String   @id @default(cuid())
  name                  String   @unique
  maxWeeklyHours        Float    @default(40)
  // Supuesto operativo configurable. ET art. 34.3 fija 9h ordinarias salvo convenio/acuerdo.
  maxDailyHours         Float    @default(12)
  // ET art. 34.3: minimo general entre jornadas en España = 12h.
  minRestBetweenShiftsH Float    @default(12)
  maxConsecutiveDays    Int      @default(6)
  nightStartHour        Int      @default(22)
  nightEndHour          Int      @default(6)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  entity        String?
  entityId      String?
  userId        String?
  userName      String?
  userRole      String?
  summary       String?
  oldData       String?
  newData       String?
  result        String   @default("success")
  errorMessage  String?
  appVersion    String?
  engineVersion String?
  createdAt     DateTime @default(now())
}

model LegalRecord {
  id               String   @id @default(cuid())
  key              String   @unique
  title            String
  category         String
  norm             String
  location         String?
  reference        String?
  eliUrl           String?
  officialUrl      String?
  hasLiteralQuote  Boolean  @default(false)
  literalQuote     String?
  quoteSource      String?
  operativeSummary String?
  status           String   @default("pendiente_revision")
  sourceType       String   @default("boe")
  reviewDate       String?
  internalNotes    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  legalParameters  LegalParameter[]
}

model LegalParameter {
  id             String       @id @default(cuid())
  key            String       @unique
  label          String
  value          String
  unit           String?
  category       String
  effectiveFrom  String?
  effectiveTo    String?
  isActive       Boolean      @default(true)
  notes          String?
  legalRecordId  String?
  legalRecord    LegalRecord? @relation(fields: [legalRecordId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ConfigAuditLog {
  id             String   @id @default(cuid())
  action         String
  userEmail      String?
  userName       String?
  role           String?
  oldVersion     String?
  newVersion     String?
  changesApplied String?
  fileSource     String?
  result         String
  errorMessage   String?
  createdAt      DateTime @default(now())
}
