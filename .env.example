# Entorno — MediQuote Pro (instancia GASI)
# Copiar este archivo a .env y ajustar los valores

# Base de datos SQLite
DATABASE_URL=file:./db/custom.db

# Firma de sesiones. Obligatorio en producción; usar un valor aleatorio de 32+ bytes.
# Generar, por ejemplo, con: openssl rand -base64 48
SESSION_SECRET=

# Retención de copias SQLite (automática antes de la primera escritura diaria)
GASI_BACKUP_RETENTION=30

# Opcional: contraseñas iniciales. Si se omiten, el seed genera valores aleatorios
# y los muestra una sola vez en la terminal.
# GASI_MAESTRO_INITIAL_PASSWORD=
# GASI_ADMIN_INITIAL_PASSWORD=
# GASI_COMMERCIAL_INITIAL_PASSWORD=

# Versión de la aplicación (se muestra en panel de branding)
APP_VERSION=0.2.0

# Versión del motor de cálculo
CALCULATION_ENGINE_VERSION=2.0.0

# Selector de rol para desarrollo (NO activar en producción)
# NEXT_PUBLIC_DEV_ROLE_SWITCH=true

# Puerto del servidor (por defecto 3000)
# PORT=3000

# Consejo IA (servidor únicamente). Por defecto se usa el modo demo, sin consumo.
OPENAI_DEMO_MODE=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
# OPENAI_TIMEOUT_MS=25000
